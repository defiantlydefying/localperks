# Copy to .env for local testing. Never commit real credentials.
# Pick an available open-weight model from your Backboard model dashboard.
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=
BACKBOARD_MODEL=
# Keep disabled until the account's free allowance and selected model are verified.
# Never enable paid usage or buy credits for this integration.
BACKBOARD_FREE_ACCESS_CONFIRMED=false
# Default local server: http://127.0.0.1:4173
# DATA_DIR=.data
